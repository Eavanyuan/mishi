# 觅诗后端环境变量配置
# 复制此文件为 .env 并根据需要修改

# 服务器配置
MISHI_SERVER_ADDRESS=:8080
MISHI_SERVER_MODE=debug
MISHI_SERVER_READ_TIMEOUT=30
MISHI_SERVER_WRITE_TIMEOUT=30

# 数据库配置
MISHI_DATABASE_HOST=postgres
MISHI_DATABASE_PORT=5432
MISHI_DATABASE_USER=mishi
MISHI_DATABASE_PASSWORD=
MISHI_DATABASE_DBNAME=mishi
MISHI_DATABASE_SSLMODE=disable
MISHI_DATABASE_MAX_CONNS=20

# Redis配置
MISHI_REDIS_HOST=redis
MISHI_REDIS_PORT=6379
MISHI_REDIS_PASSWORD=
MISHI_REDIS_DB=0

# 邮件配置（忘记密码）
MISHI_EMAIL_HOST=smtp.example.com
MISHI_EMAIL_PORT=587
MISHI_EMAIL_USERNAME=your_smtp_user
MISHI_EMAIL_PASSWORD=your_smtp_password
MISHI_EMAIL_FROM_ADDRESS=no-reply@mishi.app
MISHI_EMAIL_FROM_NAME=Mishi
MISHI_EMAIL_RESET_URL=

# JWT 配置
MISHI_JWT_SECRET=
MISHI_JWT_ACCESS_TTL_MINUTES=60
MISHI_JWT_REFRESH_TTL_DAYS=30
MISHI_JWT_ISSUER=mishi-backend

# AI 编排配置（全局厂商切换）
MISHI_AI_PROVIDER=deepseek
MISHI_AI_TIMEOUT_SECONDS=30
MISHI_AI_MAX_RETRIES=2

# OpenAI
MISHI_AI_OPENAI_API_KEY=
MISHI_AI_OPENAI_BASE_URL=https://api.openai.com/v1
MISHI_AI_OPENAI_LLM_MODEL=gpt-4o-mini
MISHI_AI_OPENAI_TTS_MODEL=gpt-4o-mini-tts
MISHI_AI_OPENAI_VIDEO_MODEL=sora-2

# DeepSeek
MISHI_AI_DEEPSEEK_API_KEY=
MISHI_AI_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISHI_AI_DEEPSEEK_LLM_MODEL=deepseek-chat
MISHI_AI_DEEPSEEK_TTS_MODEL=
MISHI_AI_DEEPSEEK_VIDEO_MODEL=

# SeedDance 2.0
MISHI_AI_SEEDDANCE_API_KEY=
MISHI_AI_SEEDDANCE_BASE_URL=
MISHI_AI_SEEDDANCE_LLM_MODEL=seeddance2.0
MISHI_AI_SEEDDANCE_TTS_MODEL=seeddance2.0-tts
MISHI_AI_SEEDDANCE_VIDEO_MODEL=seeddance2.0-video

# 日志配置
MISHI_LOG_LEVEL=info
MISHI_LOG_FORMAT=json
